# Copy this file to .env and fill in values.

# long_connection: this laptop actively connects to Feishu; no public domain needed.
# webhook: Feishu calls back into /feishu/events; requires a public HTTPS URL.
SECRETARY_FEISHU_EVENT_MODE=long_connection

# Used only when SECRETARY_FEISHU_EVENT_MODE=webhook.
SECRETARY_HOST=0.0.0.0
SECRETARY_PORT=8080

# SQLite database path. Keep it local and tiny.
SECRETARY_DATABASE=data/secretary.sqlite3
SECRETARY_LOG_FILE=data/secretary.log

# All stored schedule timestamps are UTC. Naive input is interpreted with this zone.
SECRETARY_DEFAULT_TIMEZONE=Asia/Shanghai
SECRETARY_POLL_SECONDS=15

# Comma-separated Feishu open_id values allowed to control Codex.
# Send /whoami to the bot to see your open_id.
SECRETARY_ALLOWED_OPEN_IDS=

# Codex TUI bridge. Linux server deployment expects tmux.
CODEX_TUI_COMMAND=codex
CODEX_TUI_WORKDIR=codex-workspace
CODEX_TUI_TMUX_SESSION=secretary-codex
CODEX_TUI_CAPTURE_LINES=160
CODEX_TUI_RESPONSE_TIMEOUT_SECONDS=30
CODEX_TUI_STABLE_SECONDS=4
CODEX_TUI_MAX_REPLY_CHARS=3500

# Feishu/Lark Open Platform self-built app credentials.
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Optional: for one-way fallback messages when app credentials are not configured.
FEISHU_WEBHOOK_URL=

# Optional search provider. If absent, the app uses DuckDuckGo instant answer API.
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
